# ============================================================
# AI Software Engineering Agent — 环境变量模板
# 使用方法：cp .env.example .env 后按需修改
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=software_engineering_agent
# 后端使用的异步数据库连接串（本地开发指向 localhost，容器内指向 postgres）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/software_engineering_agent

# ---------- Redis ----------
# 注意：宿主 6379 被 VMware vmnat 占用，Docker Redis 映射到 16379
REDIS_URL=redis://localhost:16379/0

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=true
# 允许跨域的前端来源（JSON 数组）
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Frontend ----------
# 前端访问后端 API 的地址（浏览器端）
NEXT_PUBLIC_API_URL=http://localhost:8000
