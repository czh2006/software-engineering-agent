# ============================================================
# Backend 环境变量模板
# 使用方法：cp .env.example .env
# ============================================================

# ---------- 应用 ----------
APP_NAME=AI Software Engineering Agent
ENVIRONMENT=development
DEBUG=true

# ---------- 服务 ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------- 跨域 ----------
# 允许的前端来源（JSON 数组）
CORS_ORIGINS=["http://localhost:3000"]

# ---------- 数据库 ----------
# PostgreSQL（异步驱动）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/software_engineering_agent

# ---------- Redis ----------
# 注意：宿主 6379 被 VMware vmnat 占用，Docker Redis 映射到 16379
REDIS_URL=redis://localhost:16379/0
